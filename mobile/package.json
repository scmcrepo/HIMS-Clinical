{
  "name": "hims-patient-app",
  "version": "0.1.0",
  "private": true,
  "description": "HIMS Patient Self-Service Portal — iOS + Android client",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.0",
    "expo-font": "^57.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-local-authentication": "~15.0.0",
    "expo-localization": "~16.0.0",
    "expo-print": "~14.0.3",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-pdf": "^6.7.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
