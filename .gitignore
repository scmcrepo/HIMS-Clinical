# Gradle
.gradle/
build/
bin/
out/

# Node.js
node_modules/
dist/
.env
.eslintcache

# IDEs
.vscode/
.idea/
*.swp

# Runtime logs — WO-032 / F4.
# *.log alone missed the directory, and LOG_PATH defaults to ./logs relative to
# the working directory, which is often the parent of this repo. A 3.5MB
# application-debug.log was shipped inside a source archive before this rule
# existed; it happened to be clean, and that was luck rather than design.
# Exclude the directories too, and keep them out of any tarball or zip you send.
*.log
application.log*
logs/
backend/logs/
**/logs/

# Eclipse / JDT Language Server metadata (machine-specific paths)
.classpath
.factorypath
.project
.settings/
.apt_generated/
.apt_generated_tests/

# OS
.DS_Store
Thumbs.db

# SonarQube
.scannerwork/
.sonar/
frontend/coverage/

# Python (agent-service)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
